    function get_participant_data() {
        $participant = $this->General_Model->get_data('participant_details', '*', 'school_code = "' . $this->input->post('hidSchoolId') . '" AND admn_no = "' . $this->input->post('hidADNO') . '"');
        if (!empty($participant)) {
