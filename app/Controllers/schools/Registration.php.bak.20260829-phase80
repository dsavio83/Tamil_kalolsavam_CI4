    function handle_photo_upload() {
        $school_code = (int) $this->input->post('hidSchoolId');
        $admn_no = $this->input->post('txtADNO');
        $participant_name = $this->input->post('txtParticipantName');

        if (!empty($_FILES['userfile']['name'])) {
            $subDistrict = $this->session->get('SUB_DISTRICT');
            if (!$subDistrict) {
                $subDistrictData = $this->General_Model->get_data('school_master', 'sub_district_code', array('school_code' => $school_code));
                if (!empty($subDistrictData)) {
                    $subDistrict = $subDistrictData[0]['sub_district_code'];
                }
            }

            if (!$subDistrict) {
                $this->template->write('error', 'Sub district not found for school code: ' . $school_code);
                return;
            }

            // Create filename as SchoolCode_AdmissionNumber
            $filename = $school_code . '_' . $admn_no;

            $_FILES['userfile']['name'] = $filename . strtolower($this->upload->get_extension($_FILES['userfile']['name']));

            $upload_path = 'photos/' . $subDistrict . '/' . $school_code . '/';
            $config['upload_path'] = $upload_path;
            $config['allowed_types'] = 'gif|jpg|png|jpeg';
            $config['max_size'] = '1000';
            $config['max_width'] = '1500';
            $config['max_height'] = '1500';
            $config['overwrite'] = TRUE;

            // Ensure directory exists
            $full_path = FCPATH . $upload_path;
            if (!is_dir($full_path)) {
                if (!mkdir($full_path, 0777, true)) {
                    $this->template->write('error', 'Failed to create upload directory: ' . $full_path);
                    return;
                }
            }

            $this->upload->initialize($config);

            if (!$this->upload->do_upload()) {
                $this->template->write('error', $this->upload->display_errors());
            } else {
                $finfo = $this->upload->data();
                $config1['image_library'] = 'gd2';
                $config1['source_image'] = $finfo['full_path'];
                $config1['create_thumb'] = false;
                $config1['maintain_ratio'] = TRUE;
                $config1['width'] = 150;
                $config1['height'] = 150;
                $this->image_lib->initialize($config1);

                if (!$this->image_lib->resize()) {
                    $this->template->write('error', $this->image_lib->display_errors());
                }
                $this->image_lib->clear();
            }
        }
    }

