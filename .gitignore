#-------------------------
# Environment & Secrets
#-------------------------
.env
.temp-env.bat
*.env
*.key
*.pem

#-------------------------
# Operating Specific Junk
#-------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
*~
.directory
.Trash-*

#-------------------------
# Temporary & Runtime Files (CodeIgniter 4)
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log
*.log

#-------------------------
# Application Uploads & Local Backups
#-------------------------
/uploads/*
!/uploads/index.html
/photos/*
!/photos/index.html
/dbBackup/

#-------------------------
# Dependencies & Package Managers
#-------------------------
/vendor/
/node_modules/
package-lock.json
composer.lock

#-------------------------
# Test & Automation Artifacts
#-------------------------
/tests/coverage*
/build/.phpunit.cache/
/build/logs/
/.automation/
/automation/
/.opencode/
/.freebuff/
/_audit/
/_backup*/
inspect_*.html
*cookies*.txt

#-------------------------
# IDE / Editor Files
#-------------------------
.idea/
*.iml
/nbproject/
.vscode/
*.sublime-workspace
*.sublime-project
